# Peavalu — environment variables
#
# Railway: service → Variables → Raw Editor, paste this and fill in the values.
# Locally none of this is needed: without it the app runs in debug mode on SQLite.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The database. On Railway, reference your Postgres service instead of pasting a URL:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave it out to use SQLite on an attached volume instead.
DATABASE_URL=

# --- Optional ----------------------------------------------------------------

# Debug is off on Railway and on locally; set 1 only to troubleshoot.
# DJANGO_DEBUG=0

# Railway's own domain is allowed automatically. Add custom domains here (comma-separated).
# DJANGO_ALLOWED_HOSTS=peavalu.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://peavalu.example.com

# Only for SQLite: put the database file somewhere specific.
# SQLITE_PATH=/data/db.sqlite3
